# TalkingToad — Environment Variables
# Copy to .env (backend) or .env-ttoad (custom settings)
# Never commit .env files to source control

# ── Auth ──────────────────────────────────────────────────────────────────────

# Bearer token protecting the crawl endpoints (leave blank to disable auth in dev)
AUTH_TOKEN=

# ── Data store ────────────────────────────────────────────────────────────────

# The Upstash Redis job store was REMOVED on 2026-08-31. Setting
# UPSTASH_REDIS_REST_URL or UPSTASH_REDIS_REST_TOKEN now RAISES at startup
# rather than silently falling back to SQLite and writing your data somewhere
# you did not configure. Do not set them.

# SQLite is the only store. In production, point it at a mounted volume.
DATABASE_URL=sqlite:///./talkingtoad.db
# Alternative: direct path (no sqlite:/// prefix)
# SQLITE_PATH=talkingtoad.db

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (no wildcards in prod)
ALLOWED_ORIGINS=http://localhost:5173

# ── Crawler ───────────────────────────────────────────────────────────────────

CRAWLER_USER_AGENT=NonprofitCrawler/1.0 (+https://github.com/dbgnvan2/talkingtoad)
MAX_PAGES_PER_CRAWL=500
CRAWL_REQUEST_TIMEOUT_S=5
RESCAN_TIMEOUT_S=20

# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO

# ── Rate limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT_ENABLED=true

# ── Data retention ────────────────────────────────────────────────────────────

RESULT_TTL_DAYS=7

# ── AI Analysis (v1.7+) ───────────────────────────────────────────────────────

# Provide at least one of these to enable AI analysis and remediation.
# If both are provided, Gemini is used by default.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Testing value for verification (can be in .env-ttoad)
API_KEY_READ=

# ── Search Console OAuth (M6.1) ───────────────────────────────────────────────

# Opt-in. With all three unset, the GSC endpoints report "not configured" and
# every dependent surface degrades cleanly rather than erroring.
# Stored credentials are encrypted with Fernet using AI_CREDS_ENCRYPTION_KEY.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=

# Fernet key encrypting stored OAuth / per-customer AI credentials at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDS_ENCRYPTION_KEY=

# ── Core Web Vitals (D2) ──────────────────────────────────────────────────────

# One Google Cloud API key, with BOTH of these enabled in the same project:
#   - PageSpeed Insights API   (lab data, any URL)
#   - Chrome UX Report API     (field data: real Chrome users, 28-day window)
# Free tier, no billing card. Console: https://console.cloud.google.com
#
# Without it: POST /api/crawl/{id}/web-vitals falls back to keyless PageSpeed at a
# much lower shared quota, so you get LAB data only — and lab data never raises a
# finding, because a synthetic run is not a measurement of your visitors. The
# report omits the section and says so in Scope, Method and Caveats.
#
# Read from env only, never persisted, and scrubbed from every error string
# (Google takes it as a query parameter, so a transport error would otherwise
# carry it into the log and the response body).
TT_PSI_API_KEY=

# ── Off-site authority (D1) ───────────────────────────────────────────────────

# NOT YET READ BY ANY CODE — reserved for a proposed "D5 Moz authority
# enrichment" (Domain/Page Authority, referring root domains, spam score) on the
# Off-Site Authority report section. Documented here because a live token already
# exists in the sibling serp-discover project; wiring it into TalkingToad is an
# open architectural decision, not a done deal.
#
# What IS built today needs no key: the Off-Site section consumes Search
# Console's own Links report via the Performance Bundle's `site.links` section.
# See functional-specification 7.10.
# MOZ_TOKEN=

# ── Frontend (frontend/.env.local) ────────────────────────────────────────────

# Auth token must match AUTH_TOKEN above (omit if AUTH_TOKEN is blank)
# VITE_AUTH_TOKEN=
